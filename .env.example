# ============================================================
# AFRO'O FOREVER BOT — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Supabase — Project Settings > Database > Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.[REF].supabase.co:5432/postgres

# Numéros super-admins (sans +, sans @c.us, séparés par virgules)
# INCLURE le numéro du bot si c'est le même qui tape les commandes
SUPER_ADMIN_NUMBERS=237600000000,237600000001

# Port HTTP (Railway fournit PORT automatiquement — ne pas changer)
PORT=8080

# Environnement
NODE_ENV=production
